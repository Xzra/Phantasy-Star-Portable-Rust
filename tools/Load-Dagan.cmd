@echo off
setlocal
set "PSP_PREVIEW_DIR=%~dp0"
if not defined PSP_MODEL_APP set "PSP_MODEL_APP=model-viewer.exe"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; function ModelHash($p) { $stream=[IO.File]::OpenRead($p); $sha=[Security.Cryptography.SHA256]::Create(); try { ([BitConverter]::ToString($sha.ComputeHash($stream))).Replace('-','').ToLowerInvariant() } finally { $stream.Dispose(); $sha.Dispose() } }; $root=$env:PSP_PREVIEW_DIR; $folder=Join-Path $root 'local'; New-Item -ItemType Directory -Force $folder | Out-Null; function Prepare($name,$hash,$archive) { $file=Join-Path $folder $name; if (!(Test-Path -LiteralPath $file)) { Write-Host ('Downloading '+$name+' from the official PSO2 patch server...'); $temp=$file+'.download'; Invoke-WebRequest -UseBasicParsing -UserAgent 'AQUA_HTTP' -Uri ('https://download.pso2.jp/patch_prod/v74000_rc_83_masterbase/patches/data/win32/'+$archive+'.pat') -OutFile $temp -TimeoutSec 60; if ((ModelHash $temp) -ne $hash) { throw ('Downloaded '+$name+' did not match its verified checksum.') }; Move-Item -LiteralPath $temp -Destination $file }; if ((ModelHash $file) -ne $hash) { throw ('Cached '+$name+' differs from the verified archive. Remove that file from local to download it again.') }; return $file }; $file=Prepare 'dagan.ice' '4f99143916c24cdbda9fc9be4fc4c8c2e268119f66269de37d13c177b9e76f96' '15d422cd829ec44a9584cf019d9f9014'; $motion=Prepare 'dagan-motion.ice' 'e5e57e0684c2a9a948e4bfe70570efc3a7723870c37134b947ba7de010db4629' '42c9afc07d6eb8a45a56fab381893948'; Write-Host 'Dagan model and motion archives verified.'; if ($env:PSP_PREPARE_ONLY -ne '1') { $arguments=@($file); if ($env:PSP_MODEL_APP -eq 'phantasy-star.exe') { $arguments+=$motion } else { $arguments+=@('--motions',$motion) }; & (Join-Path $root $env:PSP_MODEL_APP) @arguments; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE } }"
if errorlevel 1 (
  echo Model or animation setup failed. You can also open your own supported files.
  if not "%PSP_PREPARE_ONLY%"=="1" pause
  exit /b 1
)
